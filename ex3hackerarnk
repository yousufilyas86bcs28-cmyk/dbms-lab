-- 8. THE REPORT 
CREATE TABLE temp_report (
    student_name VARCHAR(100),
    grade        INT,
    marks        INT
);
 
INSERT INTO temp_report (student_name, grade, marks)
SELECT s.name, g.grade, s.marks
FROM Students s, Grades g
WHERE s.marks BETWEEN g.min_mark AND g.max_mark;
 
SELECT
    CASE
        WHEN grade >= 8 THEN student_name
        ELSE 'NULL'
    END AS name,
    grade,
    marks
FROM temp_report
ORDER BY
    grade DESC,
    (CASE WHEN grade >= 8 THEN student_name ELSE NULL END) ASC,
    (CASE WHEN grade < 8  THEN marks ELSE NULL END) ASC;
 
DELETE FROM temp_report;
 
