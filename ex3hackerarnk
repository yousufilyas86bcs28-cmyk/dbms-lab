-- 7. NEW COMPANIES

 
CREATE TABLE temp_hierarchy (
    company_code        VARCHAR(50),
    founder             VARCHAR(100),
    lead_manager_code   VARCHAR(50),
    senior_manager_code VARCHAR(50),
    manager_code        VARCHAR(50),
    employee_code       VARCHAR(50)
);
 
INSERT INTO temp_hierarchy
    (company_code, founder, lead_manager_code, senior_manager_code, manager_code, employee_code)
SELECT c.company_code, c.founder,
       lm.lead_manager_code, sm.senior_manager_code,
       m.manager_code, e.employee_code
FROM Company c, Lead_Manager lm, Senior_Manager sm, Manager m, Employee e
WHERE c.company_code         = lm.company_code
  AND lm.lead_manager_code   = sm.lead_manager_code
  AND sm.senior_manager_code = m.senior_manager_code
  AND m.manager_code         = e.manager_code;
 
SELECT
    company_code,
    founder,
    COUNT(DISTINCT lead_manager_code),
    COUNT(DISTINCT senior_manager_code),
    COUNT(DISTINCT manager_code),
    COUNT(DISTINCT employee_code)
FROM temp_hierarchy
GROUP BY company_code, founder
ORDER BY company_code ASC;
 
DELETE FROM temp_hierarchy;
 
 
