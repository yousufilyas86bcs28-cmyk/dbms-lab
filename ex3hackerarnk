-- 6. 15 DAYS OF LEARNING SQL
 
CREATE TABLE temp_dates (
    submission_date DATE,
    day_number      INT
);
 
INSERT INTO temp_dates (submission_date, day_number)
SELECT DISTINCT submission_date,
       DATEDIFF(DAY, '2016-03-01', submission_date)
FROM Submissions;
 
CREATE TABLE temp_streak_counts (
    submission_date DATE,
    streak_hackers  INT
);
 
INSERT INTO temp_streak_counts (submission_date, streak_hackers)
SELECT d.submission_date, COUNT(DISTINCT s.hacker_id)
FROM temp_dates d, Submissions s
WHERE s.submission_date <= d.submission_date
GROUP BY d.submission_date, d.day_number
HAVING COUNT(DISTINCT s.submission_date) = d.day_number + 1;
 
CREATE TABLE temp_top_hacker (
    submission_date DATE,
    hacker_id       INT,
    hacker_name     VARCHAR(100),
    sub_count       INT
);
 
INSERT INTO temp_top_hacker (submission_date, hacker_id, hacker_name, sub_count)
SELECT s.submission_date, s.hacker_id, h.name, COUNT(s.submission_id)
FROM Submissions s, Hackers h
WHERE s.hacker_id = h.hacker_id
GROUP BY s.submission_date, s.hacker_id, h.name;
 

DELETE FROM temp_top_hacker
WHERE sub_count < (
    SELECT MAX(t2.sub_count)
    FROM temp_top_hacker t2
    WHERE t2.submission_date = temp_top_hacker.submission_date
);
 
SELECT
    sc.submission_date,
    sc.streak_hackers,
    th.hacker_id,
    th.hacker_name
FROM temp_streak_counts sc, temp_top_hacker th
WHERE sc.submission_date = th.submission_date
ORDER BY sc.submission_date;
 
DELETE FROM temp_dates;
DELETE FROM temp_streak_counts;
DELETE FROM temp_top_hacker;
 
 
