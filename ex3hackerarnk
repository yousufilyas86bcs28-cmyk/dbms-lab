-- 4. TOP COMPETITOR
 
CREATE TABLE temp_full_score (
    hacker_id    INT,
    hacker_name  VARCHAR(100),
    challenge_id INT
);
 
INSERT INTO temp_full_score (hacker_id, hacker_name, challenge_id)
SELECT s.hacker_id, h.name, s.challenge_id
FROM Submissions s, Hackers h, Challenges c, Difficulty d
WHERE s.hacker_id        = h.hacker_id
  AND s.challenge_id     = c.challenge_id
  AND c.difficulty_level = d.difficulty_level
  AND s.score            = d.score;
 
SELECT hacker_id, hacker_name
FROM temp_full_score
GROUP BY hacker_id, hacker_name
HAVING COUNT(DISTINCT challenge_id) > 1
ORDER BY COUNT(DISTINCT challenge_id) DESC, hacker_id ASC;
 
DELETE FROM temp_full_score;
 
 
