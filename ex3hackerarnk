1. CONTEST LEADERBOARD
 
CREATE TABLE temp_max_scores (
    hacker_id    INT,
    challenge_id INT,
    max_score    INT
);
 
INSERT INTO temp_max_scores (hacker_id, challenge_id, max_score)
SELECT hacker_id, challenge_id, MAX(score)
FROM Submissions
GROUP BY hacker_id, challenge_id;
 
SELECT h.hacker_id,
       h.name,
       SUM(t.max_score) AS total_score
FROM Hackers h, temp_max_scores t
WHERE h.hacker_id = t.hacker_id
GROUP BY h.hacker_id, h.name
HAVING SUM(t.max_score) > 0
ORDER BY total_score DESC, h.hacker_id ASC;
 
DELETE FROM temp_max_scores;
 
 
