-- 5. INTERVIEWS
 
CREATE TABLE temp_sub_stats (
    challenge_id               INT,
    total_submissions          INT,
    total_accepted_submissions INT
);
 
INSERT INTO temp_sub_stats (challenge_id, total_submissions, total_accepted_submissions)
SELECT challenge_id, SUM(total_submissions), SUM(total_accepted_submissions)
FROM Submission_Stats
GROUP BY challenge_id;
 
CREATE TABLE temp_view_stats (
    challenge_id       INT,
    total_views        INT,
    total_unique_views INT
);
 
INSERT INTO temp_view_stats (challenge_id, total_views, total_unique_views)
SELECT challenge_id, SUM(total_views), SUM(total_unique_views)
FROM View_Stats
GROUP BY challenge_id;
 
CREATE TABLE temp_contest_map (
    contest_id   INT,
    hacker_id    INT,
    name         VARCHAR(100),
    challenge_id INT
);
 
INSERT INTO temp_contest_map (contest_id, hacker_id, name, challenge_id)
SELECT c.contest_id, c.hacker_id, c.name, ch.challenge_id
FROM Contests c, Colleges col, Challenges ch
WHERE c.contest_id   = col.contest_id
  AND col.college_id = ch.college_id;
 
SELECT
    m.contest_id,
    m.hacker_id,
    m.name,
    SUM(ss.total_submissions)          AS total_submissions,
    SUM(ss.total_accepted_submissions) AS total_accepted_submissions,
    SUM(vs.total_views)                AS total_views,
    SUM(vs.total_unique_views)         AS total_unique_views
FROM temp_contest_map m, temp_sub_stats ss, temp_view_stats vs
WHERE m.challenge_id = ss.challenge_id
  AND m.challenge_id = vs.challenge_id
GROUP BY m.contest_id, m.hacker_id, m.name
HAVING
    SUM(ss.total_submissions)          > 0 OR
    SUM(ss.total_accepted_submissions) > 0 OR
    SUM(vs.total_views)                > 0 OR
    SUM(vs.total_unique_views)         > 0
ORDER BY m.contest_id;
 
DELETE FROM temp_sub_stats;
DELETE FROM temp_view_stats;
DELETE FROM temp_contest_map;
 
 
