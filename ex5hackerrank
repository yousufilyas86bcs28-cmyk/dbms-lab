-- EX5 HACKERRANK - JOIN QUERIES
 
 
-- 1. COMBINE TWO TABLES (LEFT JOIN)
SELECT
    p.firstName,
    p.lastName,
    a.city,
    a.state
FROM Person p
LEFT JOIN Address a
    ON p.personId = a.personId;
 
 
-- 2. CONSECUTIVE NUMBERS (INNER JOIN)
SELECT DISTINCT l1.num AS ConsecutiveNums
FROM Logs l1
JOIN Logs l2
    ON l1.id = l2.id - 1
JOIN Logs l3
    ON l2.id = l3.id - 1
WHERE l1.num = l2.num
  AND l2.num = l3.num;
 
 
-- 3. TRIPS AND USERS (INNER JOIN)
SELECT
    t.request_at AS Day,
    ROUND(
        SUM(CASE
                WHEN t.status != 'completed' THEN 1
                ELSE 0
            END) / COUNT(*),
        2
    ) AS `Cancellation Rate`
FROM Trips t
JOIN Users c
    ON t.client_id = c.users_id AND c.banned = 'No'
JOIN Users d
    ON t.driver_id = d.users_id AND d.banned = 'No'
WHERE t.request_at BETWEEN '2013-10-01' AND '2013-10-03'
GROUP BY t.request_at;
 
 
-- 4. MANAGERS WITH 5 REPORTS (SELF JOIN)
SELECT e1.name
FROM Employee e1
JOIN Employee e2
    ON e1.id = e2.managerId
GROUP BY e1.id, e1.name
HAVING COUNT(e2.id) >= 5;
 
-- 5. POPULATION CENSUS 
SELECT SUM(ci.POPULATION)
FROM CITY ci
WHERE ci.COUNTRYCODE IN (
    SELECT CODE
    FROM COUNTRY
    WHERE CONTINENT = 'Asia'
);

---6 olivender inventory
SELECT w.id,
       wp.age,
       w.coins_needed,
       w.power
FROM Wands w
JOIN Wands_Property wp
  ON w.code = wp.code
JOIN (
    SELECT w2.power,
           wp2.age,
           MIN(w2.coins_needed) AS min_coins
    FROM Wands w2
    JOIN Wands_Property wp2
      ON w2.code = wp2.code
    WHERE wp2.is_evil = 0
    GROUP BY w2.power, wp2.age
) t
  ON w.power = t.power
 AND wp.age = t.age
 AND w.coins_needed = t.min_coins
WHERE wp.is_evil = 0
ORDER BY w.power DESC, wp.age DESC;
