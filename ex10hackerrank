    static JPanel buildProfilePanel() {
        JPanel root = new JPanel(new BorderLayout(0, 4));
        root.add(header("My Profile – Update Personal Details"), BorderLayout.NORTH);

        JPanel form = new JPanel(new GridBagLayout());
        form.setBorder(new EmptyBorder(10, 130, 10, 130));
        GridBagConstraints gc = gbc();

        row(form, gc, 0, "Full Name :",  pfName);
        row(form, gc, 1, "Email :",      pfEmail);
        row(form, gc, 2, "Phone :",      pfPhone);
        row(form, gc, 3, "New Password :", pfPwd);
        row(form, gc, 4, "Address :",    pfAddr);

        JLabel note = new JLabel("  Leave 'New Password' blank to keep existing password.",
                SwingConstants.LEFT);
        note.setFont(new Font("Dialog", Font.ITALIC, 11));
        note.setForeground(Color.GRAY);
        GridBagConstraints nc = gbc();
        nc.gridwidth = 2; nc.gridy = 5; nc.gridx = 0;
        form.add(note, nc);

        root.add(form, BorderLayout.CENTER);

        JButton btnSave = new JButton("Save Changes");
        JButton btnBack = new JButton("Back");
        root.add(btnBar(btnSave, btnBack), BorderLayout.SOUTH);

        btnSave.addActionListener(e -> {
            String nm = pfName.getText().trim(),
                   em = pfEmail.getText().trim(),
                   ph = pfPhone.getText().trim(),
                   pw = new String(pfPwd.getPassword()),
                   ad = pfAddr.getText().trim();
            if (nm.isEmpty() || em.isEmpty()) {
                info("Name and Email cannot be empty."); return;
            }
            try {
                // Check duplicate email – allow keeping the same email
                try (ResultSet chk = ps(
                        "SELECT COUNT(*) FROM Customers WHERE email=? AND customer_id<>?",
                        em, loggedInCustomerId).executeQuery()) {
                    chk.next();
                    if (chk.getInt(1) > 0) {
                        info("That email is already used by another account."); return;
                    }
                }
                if (pw.isEmpty()) {
                    // Keep existing password
                    ps("UPDATE Customers SET name=?,email=?,phone=?,address=? "
                       + "WHERE customer_id=?",
                       nm, em, ph, ad, loggedInCustomerId).executeUpdate();
                } else {
                    ps("UPDATE Customers SET name=?,email=?,phone=?,password=?,address=? "
                       + "WHERE customer_id=?",
                       nm, em, ph, pw, ad, loggedInCustomerId).executeUpdate();
                }
                info("Profile updated successfully!");
                pfPwd.setText("");
                show(CARD_PRODUCTS);
            } catch (Exception ex) { err(ex); }
        });
        btnBack.addActionListener(e -> show(CARD_PRODUCTS));
        return root;
    }

    /** Load current customer data into the profile form fields. */
    static void loadProfile() {
        try (ResultSet rs = ps(
                "SELECT name,email,phone,address FROM Customers WHERE customer_id=?",
                loggedInCustomerId).executeQuery()) {
            if (rs.next()) {
                pfName .setText(rs.getString(1));
                pfEmail.setText(rs.getString(2));
                pfPhone.setText(rs.getString(3));
                pfAddr .setText(rs.getString(4));
                pfPwd  .setText("");
            }
        } catch (Exception ex) { err(ex); }
    }

