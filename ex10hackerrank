    static JPanel buildCartPanel() {
        JPanel root = new JPanel(new BorderLayout(0, 4));
        root.add(header("Shopping Cart"), BorderLayout.NORTH);

        tblCart = makeTable("Item ID","Product ID","Name","Unit Price (₹)","Qty","Subtotal (₹)");
