    // Fields kept at class level so loadProfile() can populate them
    static JTextField     pfName  = new JTextField(22);
    static JTextField     pfEmail = new JTextField(22);
    static JTextField     pfPhone = new JTextField(22);
    static JPasswordField pfPwd   = new JPasswordField(22);
