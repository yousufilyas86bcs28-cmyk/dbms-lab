        searchBar.add(tfKeyword);
        searchBar.add(new JLabel("  Category :"));
        searchBar.add(tfCategory);
        searchBar.add(btnFind);
        searchBar.add(btnAll);
        searchBar.setBorder(BorderFactory.createEtchedBorder());
        root.add(searchBar, BorderLayout.NORTH);

        // Results table
        tblSearch = makeTable("ID", "Product Name", "Category",
                              "Price (₹)", "Stock", "Description");
        root.add(new JScrollPane(tblSearch), BorderLayout.CENTER);

        // Bottom – add to cart from search results
        JPanel south = new JPanel(new BorderLayout());
        south.setBorder(new EmptyBorder(4, 8, 6, 8));

        JPanel leftRow = new JPanel(new FlowLayout(FlowLayout.LEFT, 6, 2));
        JTextField tfQty = new JTextField("1", 5);
        JButton btnAddToCart = new JButton("Add to Cart");
        leftRow.add(new JLabel("Quantity :")); leftRow.add(tfQty); leftRow.add(btnAddToCart);
        south.add(leftRow, BorderLayout.WEST);

        JButton btnBack = new JButton("Back to Products");
        south.add(btnBar(btnBack), BorderLayout.EAST);
        root.add(south, BorderLayout.SOUTH);

        // ── Search action ─────────────────────────────────────────────────────
        Runnable doSearch = () -> {
            String kw  = tfKeyword.getText().trim();
            String cat = tfCategory.getText().trim();
            mdl(tblSearch).setRowCount(0);
            try {
                String sql;
                Object[] params;
                if (!kw.isEmpty() && !cat.isEmpty()) {
                    sql = "SELECT product_id,product_name,category,price,stock_quantity,description "
                        + "FROM Products WHERE LOWER(product_name) LIKE ? "
                        + "AND LOWER(category) LIKE ? ORDER BY product_id";
                    params = new Object[]{"%" + kw.toLowerCase() + "%",
                                          "%" + cat.toLowerCase() + "%"};
                } else if (!kw.isEmpty()) {
                    sql = "SELECT product_id,product_name,category,price,stock_quantity,description "
                        + "FROM Products WHERE LOWER(product_name) LIKE ? ORDER BY product_id";
                    params = new Object[]{"%" + kw.toLowerCase() + "%"};
                } else if (!cat.isEmpty()) {
                    sql = "SELECT product_id,product_name,category,price,stock_quantity,description "
                        + "FROM Products WHERE LOWER(category) LIKE ? ORDER BY product_id";
                    params = new Object[]{"%" + cat.toLowerCase() + "%"};
                } else {
                    sql = "SELECT product_id,product_name,category,price,stock_quantity,description "
                        + "FROM Products ORDER BY product_id";
                    params = new Object[]{};
                }
                try (ResultSet rs = ps(sql, params).executeQuery()) {
                    while (rs.next())
                        mdl(tblSearch).addRow(new Object[]{
                            rs.getInt(1), rs.getString(2), rs.getString(3),
                            rs.getDouble(4), rs.getInt(5), rs.getString(6)});
                }
                if (mdl(tblSearch).getRowCount() == 0)
                    info("No products found matching your search.");
            } catch (Exception ex) { err(ex); }
        };

        btnFind.addActionListener(e -> doSearch.run());
        btnAll.addActionListener(e -> {
            tfKeyword.setText(""); tfCategory.setText(""); doSearch.run();
        });

        btnAddToCart.addActionListener(e -> {
            int r = tblSearch.getSelectedRow();
            if (r < 0) { info("Select a product first."); return; }
            int pid   = (int) mdl(tblSearch).getValueAt(r, 0);
            int stock = (int) mdl(tblSearch).getValueAt(r, 4);
            int q;
            try { q = Integer.parseInt(tfQty.getText().trim()); }
            catch (NumberFormatException ex) { info("Enter a valid quantity."); return; }
            if (q <= 0)    { info("Quantity must be at least 1."); return; }
            if (q > stock) { info("Only " + stock + " units available."); return; }
            try {
                try (ResultSet rs2 = ps(
                        "SELECT cart_item_id,quantity FROM Cart_Items "
                        + "WHERE cart_id=? AND product_id=?",
                        currentCartId, pid).executeQuery()) {
                    if (rs2.next())
                        ps("UPDATE Cart_Items SET quantity=? WHERE cart_item_id=?",
                                rs2.getInt(2) + q, rs2.getInt(1)).executeUpdate();
                    else
                        ps("INSERT INTO Cart_Items(cart_item_id,cart_id,product_id,quantity) "
                           + "VALUES(ci_seq.NEXTVAL,?,?,?)",
                           currentCartId, pid, q).executeUpdate();
                }
                info("Added to cart!"); tfQty.setText("1");
            } catch (Exception ex) { err(ex); }
        });

        btnBack.addActionListener(e -> show(CARD_PRODUCTS));
        return root;
    }

